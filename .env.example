# Local development environment variables
# Copy this file to .env: cp .env.example .env

# Database (for Docker Compose)
POSTGRES_DB=solar_explorer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# API
DATABASE_URL=postgresql://postgres:postgres@db:5432/solar_explorer
ALLOWED_ORIGINS=http://localhost:3000
TZ=Asia/Tokyo
API_TOKEN=local-dev-token-change-in-production

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Production (uncomment and update for deployment)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# API_TOKEN=your-secure-production-token
